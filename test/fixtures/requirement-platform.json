{
  "$note": "Synthetic protocol shapes captured for the requirement-decomposition feature. All values are invented; the workitem type/template ids in `observed` are placeholder shapes, not the real ids (those live only in the plan record and config). No real business text, document content, tokens, or signed URLs. Consumers: Tasks 2, 5, 7, 8, 9, 10 tests.",
  "tapd": {
    "envelope": {
      "ok": { "status": 1, "data": "<array|object>", "info": "success" },
      "error": { "status": 0, "info": "<message>", "data": [] }
    },
    "storyCreate": {
      "request": {
        "method": "POST",
        "path": "/stories",
        "contentType": "application/x-www-form-urlencoded",
        "auth": "Authorization: Bearer <personal-access-token>",
        "required": ["workspace_id", "name"],
        "optional": [
          "parent_id",
          "workitem_type_id",
          "templated_id",
          "description",
          "owner",
          "cc",
          "creator",
          "developer",
          "iteration_id",
          "priority_label",
          "module",
          "version",
          "category_id",
          "label",
          "is_apply_template_default_value",
          "apply_template"
        ],
        "notes": [
          "parent_id, workitem_type_id, templated_id are integers",
          "iteration_id is a string and defaults to '0'",
          "priority is deprecated in favor of priority_label",
          "no idempotency key; a retried POST creates another story",
          "this contract is documented; write permission and parent_id child creation are not write-tested yet"
        ]
      },
      "response": {
        "status": 1,
        "data": {
          "Story": {
            "id": "1000000000000000001",
            "workitem_type_id": "1000000000000000025",
            "name": "[synthetic] sample top-level story",
            "description": "<p>[synthetic] description</p>",
            "workspace_id": "1000001",
            "creator": "synthetic_user",
            "created": "2026-01-01 10:00:00",
            "modified": "2026-01-01 10:00:00",
            "status": "planning",
            "owner": "",
            "cc": "",
            "iteration_id": "0",
            "templated_id": "1000000000000000039",
            "parent_id": "0",
            "children_id": "|",
            "ancestor_id": "1000000000000000001",
            "level": "0",
            "created_from": "api"
          }
        },
        "info": "success"
      },
      "notes": "The response shape is documented; the sample values depict a top-level story. Do not infer child creation behavior from it."
    },
    "storyRead": {
      "byId": {
        "path": "/stories",
        "params": { "workspace_id": "<id>", "id": "<id[,id2,...]>", "fields": "<comma,separated>" },
        "responseItem": { "data": [{ "Story": { "id": "1000000000000000001", "name": "[synthetic]", "parent_id": "0", "children_id": "|1000000000000000002|", "ancestor_id": "1000000000000000001", "level": "0" } }] },
        "commaIdsReturnMultiple": true
      },
      "byParent": {
        "path": "/stories",
        "params": { "workspace_id": "<id>", "parent_id": "<id>", "page": 1, "limit": 200, "fields": "<comma,separated>" },
        "paging": {
          "maxLimitObserved": 200,
          "terminatesOnEmptyPage": true,
          "childrenOfSampleParent": 10,
          "page1Count": 10,
          "page2Count": 0
        }
      },
      "nameSearch": {
        "path": "/stories",
        "params": { "workspace_id": "<id>", "name": "<substring>", "page": 1, "limit": 200 },
        "behavior": "substring match; an exact parent name can return several ids, so filter for exact name and parent_id == '0' client-side",
        "verified": { "exactQueryCount": 1, "partialQueryCount": 9 }
      },
      "count": {
        "path": "/stories/count",
        "params": { "workspace_id": "<id>", "parent_id": "<id>" },
        "response": { "status": 1, "data": { "count": 10 }, "info": "success" }
      }
    },
    "observed": {
      "parent": {
        "level": "0",
        "ancestor_id": "self",
        "children_id": "||<child1>|<child2>|<child3>",
        "iteration_id": "0"
      },
      "child": {
        "level": "1",
        "parent_id": "<parent id>",
        "ancestor_id": "<parent id>",
